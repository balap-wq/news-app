model Article {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  content     String?

  author      String?
  source      String?

  url         String?   @unique
  urlToImage  String?

  publishedAt DateTime?

  category    String?
  country     String?

  userId      Int?        // ✅ FIXED (optional)
  user        User? @relation(fields: [userId], references: [id]) // ✅ FIXED

  createdAt   DateTime  @default(now())

  @@map("articles")

  @@index([category, published_at(sort: Desc)])
  @@index([country, published_at(sort: Desc)])
  @@index([published_at(sort: Desc)])
}