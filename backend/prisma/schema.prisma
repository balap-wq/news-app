model Article {
  id BigInt @id @default(autoincrement())
  title        String?
  description  String?
  content      String?
  url          String    @unique
  url_to_image String?
  source_name  String?
  author       String?
  category     String?
  country      String?
  published_at DateTime? @db.Timestamp(6)
  created_at   DateTime? @default(now()) @db.Timestamp(6)

  @@map("articles")

  @@index([category, published_at(sort: Desc)])
  @@index([country, published_at(sort: Desc)])
  @@index([published_at(sort: Desc)])
}