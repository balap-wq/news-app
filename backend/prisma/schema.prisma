generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Article {
  id BigInt @id @default(autoincrement())
  title        String?
  description  String?
  content      String?
  url          String    @unique
  url_to_image String?
  source_name  String?
  author       String?
  category     String?
  country      String?
  published_at DateTime? @db.Timestamp(6)
  created_at   DateTime? @default(now()) @db.Timestamp(6)

  @@map("articles")
}
